{
  "name": "scale-1-to-1m",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One Express + Postgres app, grown from 1 user to 1 million, one system design concept at a time.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker compose exec postgres psql -U postgres -d shop",
    "seed": "tsx src/seed.ts",
    "load": "tsx loadtest/run.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "autocannon": "^7.15.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
